# Copy this file to .env and replace the placeholders with your local values.
# Do not commit .env.

# Format:
# postgresql+psycopg2://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql+psycopg2://username:password@localhost:5432/student_alumni

# Used to sign the session cookie. Generate a long random string for anything beyond local use.
SECRET_KEY=replace-with-a-long-random-string
ENVIRONMENT=development
ALLOWED_HOSTS=localhost,127.0.0.1

# Cookie flags. Keep HTTPS-only false on local http:// development.
SESSION_HTTPS_ONLY=false
SESSION_SAME_SITE=lax
SESSION_MAX_AGE=86400

# Comma-separated frontend origins allowed to send credentials (cookies).
FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
# Legacy FRONTEND_ORIGINS remains supported. Production: explicit HTTPS origin(s).
UPLOAD_DIRECTORY=private_uploads

# Per IP for login/register/WS handshakes; per session user for requests/messages.
LOGIN_RATE_LIMIT=30
REGISTER_RATE_LIMIT=10
REQUEST_RATE_LIMIT=30
MESSAGE_RATE_LIMIT=120
WS_RATE_LIMIT=60

# Phase 4 request policy (defaults shown).
MAX_PENDING_GUIDANCE_REQUESTS=5
REQUEST_REJECTION_COOLDOWN_DAYS=30
