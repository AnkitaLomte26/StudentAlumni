# Copy to .env.docker. Generate independent 32-byte hex values; do not commit them.
POSTGRES_DB=alumni
POSTGRES_USER=alumni
POSTGRES_PASSWORD=replace-with-random-hex-password
SECRET_KEY=replace-with-independent-random-hex-secret
ENVIRONMENT=development
FRONTEND_PORT=8080
FRONTEND_ORIGIN=http://localhost:8080
ALLOWED_HOSTS=localhost,127.0.0.1,backend
SESSION_HTTPS_ONLY=false
SESSION_SAME_SITE=lax
SESSION_MAX_AGE=86400

